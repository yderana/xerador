{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es6",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "src",
    "paths": {
      "@utils/*": [
        "utils/*"
      ],
      "@auth/*": [
        "auth/*"
      ],
      "@common/*": [
        "common/*"
      ],
      "@helpers/*": [
        "helpers/*"
      ],
      "@template/*": [
        "template/*"
      ]
    }
  },
  "exclude": [
    "node_modules"
  ]
}